<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="ja" data-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>
            <c:out value="${pageTitle}" default="生徒情報管理システム" />
        </title>

        <link rel="stylesheet"
        href="<c:url value='/assets/css/app.css' />">

        <!-- 表示前にテーマを決めるため、deferを付けずに読み込む -->
        <script src="<c:url value='/assets/js/common/theme.js' />"></script>

        <!-- defer付きのスクリプトは、この記述順に実行される -->
        <script src="<c:url value='/assets/vendor/htmx.min.js' />"
        defer></script>

        <script src="<c:url value='/assets/js/common/htmx-config.js' />"
        defer></script>
    </head>
    <body class="min-h-screen bg-base-200 text-base-content">