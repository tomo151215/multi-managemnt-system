            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="m9 3-.6 2.4-2.1 1.2L4 6l-2 3.5 1.7 1.8v2.4L2 15.5 4 19l2.3-.6 2.1 1.2L9 22h6l.6-2.4 2.1-1.2 2.3.6 2-3.5-1.7-1.8v-2.4L22 9.5 20 6l-2.3.6-2.1-1.2L15 3Z"></path>
            <circle cx="12" cy="12.5" r="3"></circle>
