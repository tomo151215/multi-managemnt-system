<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!-- ホーム -->
<li>
    <a
        href="<c:url value='/app/dashboard/staff' />"
        aria-label="ホーム"
        title="ホーム"
        <c:if test="${activeMenu == 'home'}">aria-current="page"</c:if>>

        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="m3 10 9-7 9 7"></path>
            <path d="M5 9v12h14V9"></path>
            <path d="M9 21v-8h6v8"></path>
        </svg>

        <span class="dashboard-menu-label">ホーム</span>
    </a>
</li>

<!-- 出席情報 -->
<li>
    <a
        href="<c:url value='/app/attendance/index' />"
        aria-label="出席情報"
        title="出席情報"
        <c:if test="${activeMenu == 'attendance'}">aria-current="page"</c:if>>

        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="M9 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-7"></path>
            <path d="m8 11 4 4L21 4"></path>
        </svg>

        <span class="dashboard-menu-label">出席情報</span>
    </a>
</li>

<!-- 時間割 -->
