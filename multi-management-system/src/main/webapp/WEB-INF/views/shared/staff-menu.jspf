<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%--
    HTMXの設定は親のnavから継承します。
    各リンクのURLは、対応するGET Actionへ接続します。
    activeMenuはJava側のPageViewで設定します。
--%>

<!-- ホーム -->
<c:url var="staffHomeUrl" value="/app/dashboard/staff" />

<li>
    <a
        href="<c:out value='${staffHomeUrl}' />"
        data-menu-key="home"
        aria-label="ホーム"
        title="ホーム"
        <c:if test="${activeMenu == 'home'}">aria-current="page"</c:if>>

        <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="m3 10 9-7 9 7"></path>
            <path d="M5 9v12h14V9"></path>
            <path d="M9 21v-8h6v8"></path>
        </svg>

        <span class="dashboard-menu-label">ホーム</span>
    </a>
</li>

<!-- 出席情報 -->
<c:url var="staffAttendanceUrl" value="/app/attendance/index" />

<li>
    <a
        href="<c:out value='${staffAttendanceUrl}' />"
        data-menu-key="attendance"
        aria-label="出席情報"
        title="出席情報"
        <c:if test="${activeMenu == 'attendance'}">aria-current="page"</c:if>>

        <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="M9 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-7"></path>
            <path d="m8 11 4 4L21 4"></path>
        </svg>

        <span class="dashboard-menu-label">出席情報</span>
    </a>
</li>

<!-- 時間割 -->
<c:url var="staffTimetableUrl" value="/app/timetable/index" />

<li>
    <a
        href="<c:out value='${staffTimetableUrl}' />"
        data-menu-key="timetable"
        aria-label="時間割"
        title="時間割"
        <c:if test="${activeMenu == 'timetable'}">aria-current="page"</c:if>>

        <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M7 3v4"></path>
            <path d="M17 3v4"></path>
            <path d="M3 10h18"></path>
            <path d="M8 14h2M14 14h2M8 18h2M14 18h2"></path>
        </svg>

        <span class="dashboard-menu-label">時間割</span>
    </a>
</li>

<!-- 生徒要録 -->
<c:url var="staffAcademicUrl" value="/app/academic/students" />

<li>
    <a
        href="<c:out value='${staffAcademicUrl}' />"
        data-menu-key="academic"
        aria-label="生徒要録"
        title="生徒要録"
        <c:if test="${activeMenu == 'academic'}">aria-current="page"</c:if>>

        <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="M12 5v16"></path>
            <path d="M12 5C9 3 5 3 2 4v15c3-1 7-1 10 2"></path>
            <path d="M12 5c3-2 7-2 10-1v15c-3-1-7-1-10 2"></path>
        </svg>

        <span class="dashboard-menu-label">生徒要録</span>
    </a>
</li>

<!-- 成績・評価 -->
<c:url var="staffGradesUrl" value="/app/grades/index" />

<li>
    <a
        href="<c:out value='${staffGradesUrl}' />"
        data-menu-key="grades"
        aria-label="成績・評価"
        title="成績・評価"
        <c:if test="${activeMenu == 'grades'}">aria-current="page"</c:if>>

        <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="M3 3v18h18"></path>
            <path d="m6 15 5-5 4 3 6-8"></path>
            <path d="M16 5h5v5"></path>
        </svg>

        <span class="dashboard-menu-label">成績・評価</span>
    </a>
</li>

<!-- 就職活動 -->
<c:url var="staffCareerUrl" value="/app/career/overview" />

<li>
    <a
        href="<c:out value='${staffCareerUrl}' />"
        data-menu-key="career"
        aria-label="就職活動"
        title="就職活動"
        <c:if test="${activeMenu == 'career'}">aria-current="page"</c:if>>

        <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <rect x="3" y="7" width="18" height="14" rx="2"></rect>
            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            <path d="M3 12a20 20 0 0 0 18 0"></path>
            <path d="M12 12v3"></path>
        </svg>

        <span class="dashboard-menu-label">就職活動</span>
    </a>
</li>

<!-- 設定 -->
<c:url var="staffSettingsUrl" value="/app/settings/index" />

<li>
    <a
        href="<c:out value='${staffSettingsUrl}' />"
        data-menu-key="settings"
        aria-label="設定"
        title="設定"
        <c:if test="${activeMenu == 'settings'}">aria-current="page"</c:if>>

        <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="M4 7h7"></path>
            <path d="M17 7h3"></path>
            <path d="M4 17h3"></path>
            <path d="M13 17h7"></path>
            <circle cx="14" cy="7" r="3"></circle>
            <circle cx="10" cy="17" r="3"></circle>
        </svg>

        <span class="dashboard-menu-label">設定</span>
    </a>
</li>