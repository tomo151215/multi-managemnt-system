<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!-- ホーム -->
<li>
    <a
        href="<c:url value='/app/dashboard/student' />"
        aria-label="ホーム"
        title="ホーム"
        <c:if test="${activeMenu == 'home'}">aria-current="page"</c:if>>

        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <path d="m3 10 9-7 9 7"></path>
            <path d="M5 9v12h14V9"></path>
            <path d="M9 21v-8h6v8"></path>
        </svg>

        <span class="dashboard-menu-label">ホーム</span>
    </a>
</li>

<!-- 生徒情報：URLは対応するActionに合わせて変更 -->
<li>
    <a
        href="<c:url value='/app/academic/index' />"
        aria-label="生徒情報"
        title="生徒情報"
        <c:if test="${activeMenu == 'academic'}">aria-current="page"</c:if>>

        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <circle cx="8" cy="10" r="2"></circle>
            <path d="M5 16a3 3 0 0 1 6 0"></path>
            <path d="M14 9h4M14 13h4M14 17h2"></path>
        </svg>

        <span class="dashboard-menu-label">生徒情報</span>
    </a>
</li>

<!-- 就職活動：URLは対応するActionに合わせて変更 -->
<li>
    <a
        href="<c:url value='/app/career/index' />"
        aria-label="就職活動"
        title="就職活動"
        <c:if test="${activeMenu == 'career'}">aria-current="page"</c:if>>

        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true">
            <rect x="3" y="7" width="18" height="14" rx="2"></rect>
            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            <path d="M3 12a20 20 0 0 0 18 0"></path>
            <path d="M12 12v3"></path>
        </svg>

        <span class="dashboard-menu-label">就職活動</span>
    </a>
</li>