<%@ page pageEncoding="UTF-8" %>
    <%@ taglib prefix="c" uri="jakarta.tags.core" %>
        <%@ taglib prefix="fn" uri="jakarta.tags.functions" %>

            <c:url var="profileImageUrl" value="${sessionScope.loginUser.profileImagePath}" />

            <div id="dashboard-shell" class="dashboard-shell">

                <!-- 左側サイドバー -->
                <aside id="dashboard-sidebar" class="dashboard-sidebar">

                    <!-- 開閉ボタン -->
                    <div class="dashboard-sidebar-top">
                        <button id="dashboard-menu-toggle" type="button" class="btn btn-ghost btn-square btn-sm"
                            aria-label="メニューを折りたたむ" aria-expanded="true" aria-controls="dashboard-menu">

                            <!-- 展開時：閉じるアイコン -->
                            <svg class="dashboard-close-icon size-5" xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                stroke-linecap="round" aria-hidden="true">
                                <path d="m6 6 12 12M18 6 6 18"></path>
                            </svg>

                            <!-- 折りたたみ時：ハンバーガー -->
                            <svg class="dashboard-open-icon size-5" xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                stroke-linecap="round" aria-hidden="true">
                                <path d="M4 6h16M4 12h16M4 18h16"></path>
                            </svg>
                        </button>
                    </div>

                    <!-- 利用者区分で項目だけ変更 -->
                    <nav id="dashboard-menu" class="dashboard-menu" aria-label="メインメニュー">

                        <ul>
                            <c:choose>
                                <c:when test="${sessionScope.loginUser.accountType == 'STUDENT'}">
                                    <%@ include file="student-menu.jspf" %>
                                </c:when>
                                <c:when test="${sessionScope.loginUser.accountType == 'STAFF'}">
                                    <%@ include file="staff-menu.jspf" %>
                                </c:when>
                            </c:choose>
                        </ul>
                    </nav>

                    <!-- サイドバー下部：Avatarとログアウトを分離 -->
                    <div class="sidebar-account">

                        <div class="sidebar-account-avatar">
                            <div class="avatar">
                                <div class="ring-primary ring-offset-base-100 w-8 rounded-full ring-2 ring-offset-2">
                                    <img src="${fn:escapeXml(profileImageUrl)}" alt="プロフィール画像" width="32" height="32"
                                        class="object-cover">
                                </div>
                            </div>
                        </div>

                        <form method="post" action="<c:url value='/app/auth/logout' />" class="sidebar-account-form">

                            <input type="hidden" name="csrfToken" value="${fn:escapeXml(sessionScope.csrfToken)}">

                            <button type="submit" class="sidebar-account-logout" aria-label="ログアウト" title="ログアウト">

                                <span class="sidebar-account-label">ログアウト</span>

                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                    stroke-linejoin="round" aria-hidden="true">
                                    <path d="M9 4H4v16h5"></path>
                                    <path d="M9 12h12m-4-4 4 4-4 4"></path>
                                </svg>
                            </button>
                        </form>
                    </div>
                </aside>

                <header class="dashboard-navbar">
                    <div class="dashboard-navbar-actions">

                        <!-- 操作グループ -->
                        <div class="navbar-tools">

                            <a id="open-gmail" href="https://mail.google.com/mail/?view=cm&amp;fs=1" target="_blank"
                                rel="noopener noreferrer" class="btn btn-ghost btn-circle navbar-icon-button"
                                aria-label="Gmailでメールを作成（別ウィンドウ）" title="Gmailでメールを作成">

                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                    stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="m3 7 9 6 9-6"></path>
                                </svg>
                            </a>

                            <label class="swap swap-rotate btn btn-ghost btn-circle navbar-icon-button"
                                title="配色を切り替える">

                                <input type="checkbox" data-theme-toggle aria-label="ダークモードを使用する">

                                <svg class="swap-on" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <path d="M12 2v2M12 20v2M2 12h2M20 12h2"></path>
                                    <path d="m5 5 1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path>
                                </svg>

                                <svg class="swap-off" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                    stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                                </svg>
                            </label>

                        </div>

                        <span class="navbar-separator" aria-hidden="true"></span>

                        <!-- アカウントグループ -->
                        <div class="navbar-account">

                            <div class="avatar shrink-0">
                                <div class="ring-primary ring-offset-base-100 w-8 rounded-full ring-2 ring-offset-2">
                                    <img src="${fn:escapeXml(profileImageUrl)}" alt="プロフィール画像" width="32" height="32"
                                        class="object-cover">
                                </div>
                            </div>

                            <form method="post" action="<c:url value='/app/auth/logout' />">

                                <input type="hidden" name="csrfToken" value="${fn:escapeXml(sessionScope.csrfToken)}">

                                <button type="submit" class="btn btn-ghost navbar-logout" aria-label="ログアウト"
                                    title="ログアウト">

                                    <span class="hidden sm:inline">ログアウト</span>

                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                        stroke-linejoin="round" aria-hidden="true">
                                        <path d="M9 4H4v16h5"></path>
                                        <path d="M9 12h12m-4-4 4 4-4 4"></path>
                                    </svg>
                                </button>
                            </form>

                        </div>
                    </div>
                </header>

                <!-- 各画面の本文 -->
                <main id="main-content" class="dashboard-content">