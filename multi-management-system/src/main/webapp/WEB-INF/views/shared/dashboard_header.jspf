<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<c:url
    var="profileImageUrl"
    value="${sessionScope.loginUser.profileImagePath}" />

<%--
    共通レイアウト。
    このファイルでmainを開き、dashboard_foot.jspfで閉じます。
    利用者情報を含むHTMLをHTMXの履歴キャッシュへ保存しません。
--%>
<div
    id="dashboard-shell"
    class="dashboard-shell"
    hx-history="false">

    <!-- 左側サイドバー -->
    <aside id="dashboard-sidebar" class="dashboard-sidebar">

        <!-- サイドバー開閉 -->
        <div class="dashboard-sidebar-top">
            <button
                id="dashboard-menu-toggle"
                type="button"
                class="btn btn-ghost btn-square btn-sm"
                aria-label="メニューを折りたたむ"
                aria-expanded="true"
                aria-controls="dashboard-menu">

                <!-- 展開時：閉じる -->
                <svg
                    class="dashboard-close-icon size-5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    aria-hidden="true">
                    <path d="m6 6 12 12"></path>
                    <path d="M18 6 6 18"></path>
                </svg>

                <!-- 折りたたみ時：開く -->
                <svg
                    class="dashboard-open-icon size-5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    aria-hidden="true">
                    <path d="M4 6h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 18h16"></path>
                </svg>
            </button>
        </div>

        <%--
            メニューのリンクだけをHTMX化します。
            ログアウト・Gmail・配色切替はこのnavの外に配置します。

            応答内のdashboard-pageを取り出し、
            現在のdashboard-page全体と置き換えます。
        --%>
        <nav
            id="dashboard-menu"
            class="dashboard-menu"
            aria-label="メインメニュー"
            hx-boost="true"
            hx-target="#dashboard-page"
            hx-select="#dashboard-page"
            hx-swap="outerHTML"
            hx-push-url="true"
            hx-sync="#dashboard-menu:replace">

            <ul>
                <c:choose>
                    <c:when test="${sessionScope.loginUser.accountType == 'STUDENT'}">
                        <%@ include file="student-menu.jspf" %>
                    </c:when>

                    <c:when test="${sessionScope.loginUser.accountType == 'STAFF'}">
                        <%@ include file="staff-menu.jspf" %>
                    </c:when>
                </c:choose>
            </ul>
        </nav>

        <!-- 下部アカウント領域：Avatarとログアウトを分離 -->
        <div class="sidebar-account">

            <div class="sidebar-account-avatar">
                <div class="avatar shrink-0">
                    <div class="ring-primary ring-offset-base-100 w-8 rounded-full ring-2 ring-offset-2">
                        <img
                            src="<c:out value='${profileImageUrl}' />"
                            alt="プロフィール画像"
                            width="32"
                            height="32"
                            class="object-cover">
                    </div>
                </div>
            </div>

            <form
                method="post"
                action="<c:url value='/app/auth/logout' />"
                class="sidebar-account-form">

                <input
                    type="hidden"
                    name="csrfToken"
                    value="<c:out value='${sessionScope.csrfToken}' />">

                <button
                    type="submit"
                    class="sidebar-account-logout"
                    aria-label="ログアウト"
                    title="ログアウト">

                    <span class="sidebar-account-label">ログアウト</span>

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true">
                        <path d="M9 4H4v16h5"></path>
                        <path d="M9 12h12"></path>
                        <path d="m17 8 4 4-4 4"></path>
                    </svg>
                </button>
            </form>
        </div>
    </aside>

    <!-- 上部Navbar -->
    <header class="dashboard-navbar">
        <div class="dashboard-navbar-actions">

            <!-- メール・配色切替 -->
            <div class="navbar-tools">

                <!-- gmail.jsでGmail作成画面をポップアップ表示 -->
                <a
                    id="open-gmail"
                    href="https://mail.google.com/mail/?view=cm&amp;fs=1"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-ghost btn-circle navbar-icon-button"
                    aria-label="Gmailでメールを作成（別ウィンドウ）"
                    title="Gmailでメールを作成">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                        <path d="m3 7 9 6 9-6"></path>
                    </svg>
                </a>

                <!-- 共通theme.jsで配色を復元・保存 -->
                <label
                    class="swap swap-rotate btn btn-ghost btn-circle navbar-icon-button"
                    title="配色を切り替える">

                    <input
                        type="checkbox"
                        data-theme-toggle
                        aria-label="ダークモードを使用する">

                    <!-- ダークモード時：太陽 -->
                    <svg
                        class="swap-on"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true">

                        <circle cx="12" cy="12" r="4"></circle>

                        <path d="M12 2v2"></path>
                        <path d="M12 20v2"></path>
                        <path d="M2 12h2"></path>
                        <path d="M20 12h2"></path>

                        <path d="M4.93 4.93l1.42 1.42"></path>
                        <path d="M17.65 17.65l1.42 1.42"></path>
                        <path d="M4.93 19.07l1.42-1.42"></path>
                        <path d="M17.65 6.35l1.42-1.42"></path>
                    </svg>

                    <!-- ライトモード時：月 -->
                    <svg
                        class="swap-off"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true">
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                    </svg>
                </label>
            </div>

            <span class="navbar-separator" aria-hidden="true"></span>

            <!-- Avatar・ログアウト -->
            <div class="navbar-account">

                <div class="avatar shrink-0">
                    <div class="ring-primary ring-offset-base-100 w-8 rounded-full ring-2 ring-offset-2">
                        <img
                            src="<c:out value='${profileImageUrl}' />"
                            alt="プロフィール画像"
                            width="32"
                            height="32"
                            class="object-cover">
                    </div>
                </div>

                <form
                    method="post"
                    action="<c:url value='/app/auth/logout' />">

                    <input
                        type="hidden"
                        name="csrfToken"
                        value="<c:out value='${sessionScope.csrfToken}' />">

                    <button
                        type="submit"
                        class="btn btn-ghost navbar-logout"
                        aria-label="ログアウト"
                        title="ログアウト">

                        <span class="hidden sm:inline">ログアウト</span>

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true">
                            <path d="M9 4H4v16h5"></path>
                            <path d="M9 12h12"></path>
                            <path d="m17 8 4 4-4 4"></path>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </header>

    <%--
        本文の外枠。dashboard_foot.jspfで閉じます。
        通常のメニュー操作では内側のdashboard-pageだけを更新し、
        ブラウザ履歴の復元ではこのmainを復元領域にします。
    --%>
    <main
        id="main-content"
        class="dashboard-content"
        hx-history-elt>