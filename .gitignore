# ==========================================
# VS Code
# ==========================================

# フォルダ自体ではなく、中身を除外する
/.vscode/*

# チームで共有する設定は管理対象に戻す
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json

